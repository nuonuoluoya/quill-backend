{
  "name": "pidan-vocal-api",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "openapi": "tsx src/openapi.ts",
    "mock": "tsx src/mock.ts",
    "contract:check": "tsx src/openapi.ts --check",
    "schema:check": "tsx scripts/check-schemas.ts",
    "schema:update": "tsx scripts/check-schemas.ts --update",
    "db:migrate": "tsx src/migrate.ts",
    "data:transfer": "tsx src/transfer-cli.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "@electric-sql/pglite": "0.5.8",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "ajv": "8.20.0",
    "dotenv": "17.4.2",
    "music-metadata": "11.15.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
