NODE_ENV=development
PORT=3210
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3210
# Leave empty for the local PostgreSQL WASM development database. Production must use PostgreSQL.
DATABASE_URL=
DEV_DB_PATH=.data/postgres
MEDIA_ROOT=.data/media
# Generate a random value of at least 32 characters for staging/production.
MEDIA_SIGNING_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
CORS_ORIGIN=http://127.0.0.1:5178
# Optional S3-compatible private object store, including COS S3 endpoint.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPERATOR_CONTACT=

READY_TOKEN=
REQUEST_LOG=0
OPERATOR_ID=local-operator

# Exact trusted reverse-proxy IP/CIDR; leave empty for direct local development.
TRUSTED_PROXY=
