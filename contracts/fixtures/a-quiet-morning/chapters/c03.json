      "duration": 2.873469387755102,
      "alignment": {
        "status": "verified",
        "reasons": []
      }
    },
    {
      "id": "c03-s0003",
      "index": 3,
      "text": "I could hear water moving over stones.",
      "audio": "audio/c03-s3.mp3",
      "duration": 3.213061224489796,
      "alignment": {
        "status": "verified",
        "reasons": []
      }
    },
    {
      "id": "c03-s0004",
      "index": 4,
      "text": "Two children were flying a bright kite.",
