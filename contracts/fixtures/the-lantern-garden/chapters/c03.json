      "alignment": {
        "status": "verified",
        "reasons": []
      }
    },
    {
      "id": "c03-s0002",
      "index": 2,
      "text": "He left one apple beside the blue lantern.",
      "audio": "audio/c03-s2.mp3",
      "duration": 3.4481632653061225,
      "alignment": {
        "status": "verified",
        "reasons": []
      }
    },
    {
      "id": "c03-s0003",
      "index": 3,
      "text": "Then he followed the path towards the village.",
