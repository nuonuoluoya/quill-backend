{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audio content metadata extension for v2 book.json",
  "type": "object",
  "properties": {
    "contentType": {
      "enum": [
        "book",
        "blog",
        "movie",
        "tv",
        "podcast"
      ]
    },
    "coverUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "seasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "title",
          "order"
        ],
        "additionalProperties": false
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seasonId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "episodeNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "episodeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "part": {
            "enum": [
              "dialogue",
              "lesson"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "number",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "previewOfBookId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "lockedChapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "number": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "title",
          "number"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
